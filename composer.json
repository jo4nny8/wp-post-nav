{
  "name": "aquarius-home-improvements/wp-post-nav",
  "description": "Previous and next navigation for WordPress posts and custom post types.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpcompatibility/php-compatibility": "^9.0",
    "php-stubs/wordpress-stubs": "^6.8",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "scripts": {
    "lint:php": "find . -path ./vendor -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l",
    "lint:phpcs": "phpcs --standard=phpcs.xml.dist",
    "analyse": "phpstan analyse --debug --memory-limit=512M --configuration=phpstan.neon.dist",
    "test": "phpunit --configuration tests/phpunit.xml",
    "build": "sh bin/build-package.sh"
  }
}
